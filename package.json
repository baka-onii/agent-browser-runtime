{
  "name": "agent-browser-runtime",
  "version": "0.1.0",
  "description": "General browser execution runtime: deterministic automation + optional OpenJev planning",
  "keywords": ["browser", "automation", "cdp", "chromium", "agent", "rpa", "web-search", "openjev"],
  "homepage": "https://github.com/baka-onii/agent-browser-runtime",
  "repository": { "type": "git", "url": "https://github.com/baka-onii/agent-browser-runtime.git" },
  "license": "MIT",
  "engines": { "node": ">=20" },
  "files": ["dist/**", "README.md", "LICENSE", "CHANGELOG.md"],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "abr": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "typecheck": "tsc --noEmit",
    "cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/ws": "^8.5.12",
    "devtools-protocol": "^0.0.1621552",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
